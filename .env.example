# Example configuration for a local AutoAgent deployment.
# AutoAgentApp() loads .env from the current directory first, then lets process
# environment variables override values with the same names.
# Leave AUTOAGENT_DATABASE_URL empty to use an in-memory RuntimeStore only.

# Listen address and port for the embedded AutoAgentServer.
# examples/incident_response_tracing_server.py defaults to http://127.0.0.1:8765.
AUTOAGENT_SERVER_HOST=0.0.0.0
AUTOAGENT_SERVER_PORT=8765

# OpenAI-compatible Chat Completions Operator.
# examples/react_weather_agent.py uses the following settings.
# BASE_URL may point to OpenAI or any service compatible with
# POST /chat/completions.
AUTOAGENT_OPENAI_BASE_URL=https://api.openai.com/v1

# Provider API key. It is read only by the Operator configuration and is never
# stored in Workflow Runtime data.
AUTOAGENT_OPENAI_API_KEY=

# Model used when an LLMRequest does not explicitly select one.
AUTOAGENT_OPENAI_MODEL=

# Timeout for one Chat Completions HTTP request, in milliseconds.
AUTOAGENT_OPENAI_TIMEOUT_MS=60000

# Provider protocol for structured output:
# auto        Detect known providers automatically. DeepSeek uses json_object;
#             other providers default to json_schema.
# json_schema Use OpenAI's native JSON Schema protocol.
# json_object Use the JSON Object protocol and inject the schema into the prompt.
# prompt      Do not send response_format; inject the schema into the prompt only.
AUTOAGENT_OPENAI_STRUCTURED_OUTPUT_MODE=auto

# Application namespace used to isolate Workflows, Sessions, and persisted data.
AUTOAGENT_NAMESPACE=default

# Database connection URL. SQLite and PostgreSQL are supported.
# SQLite example: sqlite+aiosqlite:///./autoagent.db
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/autoagent
AUTOAGENT_DATABASE_URL=

# Whether SQLAlchemy should log generated SQL. This is normally false in production.
AUTOAGENT_DATABASE_ECHO=false

# Hard limit for one Serializer inline value, in bytes.
# Leave empty for no additional limit. Large Runtime values remain subject to
# the Artifact policy.
AUTOAGENT_SERIALIZER_MAX_INLINE_BYTES=

# Low watermark for the persistence backlog, in bytes.
# New Invocations pause after the high watermark is reached and resume only
# after the backlog falls to the low watermark.
# Required ordering: 0 <= low < high < hard.
AUTOAGENT_PERSISTENCE_QUEUE_LOW_WATERMARK_BYTES=33554432

# High watermark for the persistence backlog, in bytes. Defaults to 64 MiB.
AUTOAGENT_PERSISTENCE_QUEUE_HIGH_WATERMARK_BYTES=67108864

# Hard limit for the persistence backlog, in bytes.
# Running Invocations do not wait. New Events beyond this limit are marked as
# not persisted.
AUTOAGENT_PERSISTENCE_QUEUE_HARD_WATERMARK_BYTES=134217728

# Maximum time a new Invocation waits for the queue to recover from the high
# watermark, in milliseconds.
# On timeout, submission raises PersistenceAdmissionError and the Server returns 503.
AUTOAGENT_PERSISTENCE_ADMISSION_TIMEOUT_MS=5000

# Maximum number of persistence records written in one database transaction.
AUTOAGENT_DATABASE_BATCH_MAX_ITEMS=256

# Target maximum size of one database transaction, in bytes.
AUTOAGENT_DATABASE_BATCH_MAX_BYTES=4194304

# Maximum time the persistence thread waits to coalesce concurrent records,
# in milliseconds. This delay occurs only on the persistence thread and does
# not block Workflow execution.
AUTOAGENT_DATABASE_BATCH_MAX_DELAY_MS=5

# Maximum number of Runtime Events allowed between recovery-state writes.
# Explicit recovery boundaries such as wait/resume still request a recovery
# state write.
AUTOAGENT_DATABASE_RECOVERY_EVENT_INTERVAL=200

# SQLite synchronous level. FULL is safer; NORMAL writes faster with weaker
# power-loss guarantees. PostgreSQL does not use this setting.
AUTOAGENT_SQLITE_SYNCHRONOUS=FULL

# Maximum number of synchronous Operator calls executed by the shared thread pool.
AUTOAGENT_EXECUTOR_MAX_THREAD_WORKERS=8

# App-wide hard limit for concurrent Map/Replication units. A Workflow-level
# max_parallelism may lower this value but cannot exceed it.
AUTOAGENT_EXECUTOR_MAX_PARALLEL_UNITS=8

# Maximum graceful shutdown wait for running Invocations and pending database
# persistence, in milliseconds. Remaining work is cancelled after this deadline.
AUTOAGENT_SHUTDOWN_GRACE_TIMEOUT_MS=5000

# Whether large Runtime values are automatically externalized to the artifact table.
AUTOAGENT_ARTIFACT_ENABLED=true

# Runtime values larger than this threshold are persisted through ArtifactRef.
AUTOAGENT_ARTIFACT_INLINE_MAX_BYTES=8192

# In-memory Runtime data retention policy:
# retain_all / evict_durable_terminal / lru_durable_terminal
AUTOAGENT_RETENTION_MODE=retain_all

# Maximum number of terminal Invocations retained by lru_durable_terminal.
AUTOAGENT_RETENTION_MAX_TERMINAL_INVOCATIONS=128

# Maximum number of in-process replay checkpoints retained per Invocation.
# The sequence=0 genesis snapshot is never evicted by this limit.
AUTOAGENT_RETENTION_MAX_REPLAY_CHECKPOINTS_PER_INVOCATION=8
