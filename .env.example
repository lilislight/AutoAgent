# AutoAgent 本地部署配置示例。
# AutoAgentApp() 会先读取当前目录的 .env，再用进程环境变量覆盖同名值。
# 留空 AUTOAGENT_DATABASE_URL 表示只使用内存 RuntimeStore。

# 嵌入式 AutoAgentServer 的监听地址和端口。
# examples/incident_response_tracing_server.py 默认启动在 http://127.0.0.1:8765。
AUTOAGENT_SERVER_HOST=0.0.0.0
AUTOAGENT_SERVER_PORT=8765

# App 命名空间。它参与 Workflow、Session 和持久化数据的隔离。
AUTOAGENT_NAMESPACE=default

# 数据库连接地址。支持 SQLite 和 PostgreSQL。
# SQLite 示例：sqlite+aiosqlite:///./autoagent.db
# PostgreSQL 示例：postgresql+asyncpg://user:password@localhost:5432/autoagent
AUTOAGENT_DATABASE_URL=

# 是否输出 SQLAlchemy SQL 日志。生产环境通常保持 false。
AUTOAGENT_DATABASE_ECHO=false

# Serializer 单条内联值的硬限制，单位为字节。
# 留空表示不额外限制；大 Runtime 值仍受 Artifact 策略控制。
AUTOAGENT_SERIALIZER_MAX_INLINE_BYTES=

# 持久化积压低水位，单位为字节。
# 达到 high 后暂停新 Invocation；只有降到 low 后才重新开放。
# 必须满足：0 <= low < high < hard。
AUTOAGENT_PERSISTENCE_QUEUE_LOW_WATERMARK_BYTES=33554432

# 持久化积压高水位，单位为字节。默认 64 MiB。
AUTOAGENT_PERSISTENCE_QUEUE_HIGH_WATERMARK_BYTES=67108864

# 持久化积压硬上限，单位为字节。
# 正在执行的 Invocation 不会等待；超过该值的新 Event 会标记为未持久化。
AUTOAGENT_PERSISTENCE_QUEUE_HARD_WATERMARK_BYTES=134217728

# 新 Invocation 在 high 水位等待队列恢复的最长时间，单位为毫秒。
# 超时后提交会收到 PersistenceAdmissionError；Server 会返回 503。
AUTOAGENT_PERSISTENCE_ADMISSION_TIMEOUT_MS=5000

# 单次数据库事务最多写入的持久化记录数量。
AUTOAGENT_DATABASE_BATCH_MAX_ITEMS=256

# 单次数据库事务的目标最大字节数。
AUTOAGENT_DATABASE_BATCH_MAX_BYTES=4194304

# 持久化线程为了合并并发记录最多等待的时间，单位为毫秒。
# 该等待只发生在持久化线程，不阻塞 Workflow 执行。
AUTOAGENT_DATABASE_BATCH_MAX_DELAY_MS=5

# 两次 recovery state 写入之间最多允许的 Runtime Event 数量。
# wait/resume 等显式恢复边界仍会请求写入 recovery state。
AUTOAGENT_DATABASE_RECOVERY_EVENT_INTERVAL=200

# SQLite 同步等级：FULL 更安全；NORMAL 写入更快但掉电保证更弱。
# PostgreSQL 不使用此配置。
AUTOAGENT_SQLITE_SYNCHRONOUS=FULL

# 是否把较大的 Runtime value 自动外置到 artifact 表。
AUTOAGENT_ARTIFACT_ENABLED=true

# 超过该字节数的 Runtime value 使用 ArtifactRef 持久化。
AUTOAGENT_ARTIFACT_INLINE_MAX_BYTES=8192

# 内存 Runtime 数据保留策略：
# retain_all / evict_durable_terminal / lru_durable_terminal
AUTOAGENT_RETENTION_MODE=retain_all

# lru_durable_terminal 模式最多保留的终态 Invocation 数量。
AUTOAGENT_RETENTION_MAX_TERMINAL_INVOCATIONS=128

# 每个 Invocation 最多保留的进程内 replay checkpoint 数量。
# sequence=0 的 genesis snapshot 永远不会被该限制驱逐。
AUTOAGENT_RETENTION_MAX_REPLAY_CHECKPOINTS_PER_INVOCATION=8
