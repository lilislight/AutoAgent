    "@lezer/highlight": "1.2.5",
    "@tanstack/react-query": "^5.90.20",
    "@xyflow/react": "^12.10.1",
    "ajv": "^8.20.0",
    "elkjs": "^0.11.0",
    "jsonc-parser": "^3.3.1",
