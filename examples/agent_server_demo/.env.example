# Copy to .env. Process environment overrides this project file.
# Connection settings are consumed by Host; Workflow semantics live in project.py.
AUTOAGENT_LLM_BACKEND=openai
AUTOAGENT_LLM_PROVIDER=lm_studio
AUTOAGENT_LLM_MODEL=google/gemma-4-e4b
AUTOAGENT_LLM_BASE_URL=http://localhost:1234/v1
AUTOAGENT_LLM_API_KEY=lm-studio
AUTOAGENT_LLM_PROTOCOL=openai.chat_completions
AUTOAGENT_LLM_TIMEOUT_SECONDS=120
AUTOAGENT_LLM_STREAMING=true
# AUTOAGENT_LLM_MAX_OUTPUT_TOKENS=4096
# Optional compaction model; Provider follows the main model's Provider.
# AUTOAGENT_COMPACTION_LLM_MODEL=google/gemma-4-e4b
LITELLM_LOCAL_MODEL_COST_MAP=True

# Relative to this example's directory; separate from all other demos.
AUTOAGENT_DATABASE_URL=sqlite+aiosqlite:///.autoagent/runtime.db
AUTOAGENT_SERVER_HOST=127.0.0.1
AUTOAGENT_SERVER_PORT=8765
AUTOAGENT_LOG_LEVEL=info
AUTOAGENT_SERVER_ACCESS_LOG=true
