# Host deployment settings. Process environment overrides project .env.
# Relative SQLite paths are resolved from the project root. Async SQLite/PostgreSQL only.
AUTOAGENT_DATABASE_URL=sqlite+aiosqlite:///.autoagent/runtime.db
# durable waits for COMMIT; buffered ACKs memory acceptance and may lose its tail on a crash.
AUTOAGENT_PERSISTENCE_MODE=durable
# Positive bytes. Values at/above this threshold become content-addressed Artifacts.
AUTOAGENT_ARTIFACT_THRESHOLD_BYTES=1048576
# Positive records/bytes. Reaching count or estimated retained bytes triggers early submission.
# Encoded batch bytes also limit batch preparation; one oversized record may form its own batch.
AUTOAGENT_BATCH_COUNT=256
AUTOAGENT_BATCH_BYTES=4194304
# Finite nonnegative milliseconds for buffered group commits. Larger windows improve batching
# but increase pending-data latency and crash exposure; DB backlog may exceed this window.
AUTOAGENT_BATCH_DELAY_MS=100
# Finite nonnegative milliseconds for durable group commits. 0 avoids per-Event artificial delay.
# Explicit flushes and Checkpoint barriers bypass either normal batching window.
AUTOAGENT_DURABLE_BATCH_DELAY_MS=0
# Fraction in (0,1]. Submit early when either queue count or byte utilization reaches this ratio.
AUTOAGENT_BATCH_QUEUE_RATIO=0.8
# Positive retained records/estimated bytes. A full queue blocks Core until capacity is released.
AUTOAGENT_QUEUE_COUNT=10000
AUTOAGENT_QUEUE_BYTES=134217728
# Positive bytes for batch-local encoding memoization; released after preparation.
AUTOAGENT_ENCODING_CACHE_BYTES=16777216
# Historical state inspection: positive per-query Event scan count, cumulative packed
# JSON/Artifact decode bytes, and selected value JSON bytes. These do not change
# Artifact splitting. A narrower JSON Pointer reduces reads; oversized reads fail
# explicitly. --output does not bypass these budgets. No historical-state cache.
AUTOAGENT_INSPECTION_SCAN_EVENTS=100000
AUTOAGENT_INSPECTION_READ_BYTES=67108864
AUTOAGENT_INSPECTION_RESULT_BYTES=1048576
# Nonnegative retries and finite nonnegative milliseconds for exponential retry backoff.
AUTOAGENT_RETRY_ATTEMPTS=3
AUTOAGENT_RETRY_DELAY_MS=50
# Positive maximum concurrent Operator Calls. Node loop limits live in ResourcePolicy.
AUTOAGENT_MAX_OPERATOR_CONCURRENCY=32

# Host adaptive residency. Ratios must satisfy 0 < target < high < critical < 1.
# Nonnegative bytes: 0 chooses min(512 MiB, 80% of the available cgroup memory limit).
# Explicit budgets are process budgets, including Core, Persistence and project resources.
# Lower budgets reclaim sooner; reserve headroom for Operators and Checkpoint serialization.
AUTOAGENT_HOST_MEMORY_BUDGET_BYTES=0
# Stop a pressure sweep at this target; hysteresis reduces repeated eviction/reload cycles.
AUTOAGENT_HOST_MEMORY_TARGET_RATIO=0.65
# Begin active reclamation at this fraction of the process budget.
AUTOAGENT_HOST_MEMORY_HIGH_RATIO=0.8
# Actual RSS at this fraction rejects new residency; retained Python arenas cannot bypass it.
# Short Timer protection yields at critical pressure.
AUTOAGENT_HOST_MEMORY_CRITICAL_RATIO=0.9
# Finite nonnegative seconds without business access to classify data as cold.
# Status/trace reads do not heat a Session. Repeated recent calls increase retention priority.
AUTOAGENT_HOST_COLD_AFTER_SECONDS=300
# Finite nonnegative seconds, >= cold threshold: reclaim long-idle graphs even at low pressure.
AUTOAGENT_HOST_MAX_IDLE_SECONDS=1800
# Finite nonnegative seconds after load/admission to avoid immediate reload/eviction churn.
# Critical pressure may bypass this minimum.
# Reclaiming a full Root slot may also bypass the minimum.
AUTOAGENT_HOST_MIN_RESIDENCY_SECONDS=5
# Finite nonnegative seconds until the earliest active graph Timer. Protect these graphs below critical pressure.
AUTOAGENT_HOST_SHORT_TIMER_SECONDS=60
# Finite positive seconds between coalesced residency and durable wakeup scans.
AUTOAGENT_HOST_RESIDENCY_INTERVAL_SECONDS=1
# Positive acknowledged Event count / estimated Event bytes since the last Checkpoint.
# Crossing either threshold checkpoints a quiescent graph while retaining it in memory.
AUTOAGENT_HOST_CHECKPOINT_TAIL_EVENTS=2048
AUTOAGENT_HOST_CHECKPOINT_TAIL_BYTES=16777216
# Finite nonnegative seconds since the last Checkpoint. Only dirty quiescent graphs are saved.
# 0 checkpoints dirty graphs at the next safe scan; larger values reduce snapshot I/O.
AUTOAGENT_HOST_CHECKPOINT_INTERVAL_SECONDS=300
# Keep these newest distinct Root graph versions, plus pinned/dependency-protected snapshots.
AUTOAGENT_HOST_CHECKPOINT_KEEP_LATEST=1
# Positive maximum resident/loading Root graphs; whole child graphs consume one Root slot.
AUTOAGENT_HOST_MAX_RESIDENT_GRAPHS=128
# Positive in-flight Host request count / aggregate estimated input bytes. Exhaustion returns busy.
# Larger limits retain more caller input; request cancellation does not discard admitted work.
AUTOAGENT_HOST_MAX_REQUESTS=128
# Positive extra control slots for cancel/pause/respond/signal/continue.
# Queries or long joins cannot consume these slots; total requests are bounded by both counts.
AUTOAGENT_HOST_CONTROL_REQUEST_RESERVE=8
AUTOAGENT_HOST_MAX_REQUEST_BYTES=16777216
# Positive maximum concurrent snapshot/save/unload jobs. Larger values increase serialization peak memory.
AUTOAGENT_HOST_UNLOAD_CONCURRENCY=2
# Positive bounded recovery candidate page and background activation concurrency (<=1000).
AUTOAGENT_HOST_BACKGROUND_BATCH_SIZE=32
# Finite positive seconds before retrying a capacity-blocked or unavailable-code activation.
AUTOAGENT_HOST_BACKGROUND_RETRY_SECONDS=5

# Local FastAPI Server. Standalone mode opens the project Host and serves built UI.
AUTOAGENT_SERVER_HOST=127.0.0.1
AUTOAGENT_SERVER_PORT=8765
AUTOAGENT_SERVER_API_PREFIX=/api/v2
AUTOAGENT_SERVER_UI_PATH=/
# Empty uses the frontend assets bundled under autoagent/server/static.
# Relative override paths resolve against the project root.
AUTOAGENT_SERVER_UI_DIRECTORY=
AUTOAGENT_SERVER_PAGE_SIZE=50
AUTOAGENT_SERVER_MAX_PAGE_SIZE=200
AUTOAGENT_SERVER_QUERY_TIMEOUT_SECONDS=15
# Maximum HTTP drain time; Host persistence cleanup runs afterwards.
AUTOAGENT_SERVER_SHUTDOWN_TIMEOUT_SECONDS=15

# Temporary consistent trace export cache (disk bytes and idle lifetime).
AUTOAGENT_TRACE_SNAPSHOT_BYTES=134217728
AUTOAGENT_TRACE_SNAPSHOT_TTL_SECONDS=300

# Live tracing: subscriptions retain one coalesced notification per client.
AUTOAGENT_SERVER_TRACE_MAX_SUBSCRIBERS=128
# Finite nonnegative delay to combine committed updates; does not flush Persistence.
AUTOAGENT_SERVER_TRACE_COALESCE_MS=100
# Positive heartbeat seconds, <=30; no database connection is held while waiting.
AUTOAGENT_SERVER_TRACE_HEARTBEAT_SECONDS=10
# Host command observers and short-lived in-memory receipts for remote clients.
# Positive concurrent command limit, receipt count (>= concurrency), and retention seconds.
# An unavailable receipt is never evidence of command failure or permission to repeat a side effect.
AUTOAGENT_HOST_OPERATION_CONCURRENCY=32
AUTOAGENT_HOST_OPERATION_RECEIPTS=256
AUTOAGENT_HOST_OPERATION_TTL_SECONDS=300

# Foreground CLI log level: debug|info|warning|error|critical.
# Without an override, Server defaults to info; other CLI commands default to warning.
# --log-level overrides this; --debug enables debug logs and original tracebacks.
# SDK imports never install logging handlers. Third-party SDKs stay at warning unless debug is selected.
AUTOAGENT_LOG_LEVEL=info
# HTTP access logs: true|false|1|0, default true. Disable to reduce request log volume.
# --access-log / --no-access-log override this for the foreground Server.
AUTOAGENT_SERVER_ACCESS_LOG=true

# Optional Host-owned generation route. Empty MODEL disables automatic setup;
# no client, credential requirement or optional SDK import occurs in that case.
# Custom project Operator registrations take precedence over these defaults.
# PROVIDER is the vendor / LiteLLM route prefix. BACKEND is openai|litellm.
# Unknown vendors using openai must specify an OpenAI-compatible BASE_URL.
AUTOAGENT_LLM_PROVIDER=openai
AUTOAGENT_LLM_BACKEND=openai
AUTOAGENT_LLM_MODEL=
# Credential stays in the connection, never in requests or Workflow snapshots.
AUTOAGENT_LLM_API_KEY=
# Empty: OpenAI default, DeepSeek default, or LiteLLM vendor route default.
AUTOAGENT_LLM_BASE_URL=
# openai.chat_completions|openai.responses; vendor support is checked by Provider.
AUTOAGENT_LLM_PROTOCOL=openai.chat_completions
# Finite positive per-HTTP-call deadline in seconds; Node policies stay in Workflow.
AUTOAGENT_LLM_TIMEOUT_SECONDS=60
# true|false; backend transport streaming. Both return LLMResponse by default.
# User Events are separately configured on the Node.
AUTOAGENT_LLM_STREAMING=false
# Optional positive default output token count; request arguments override it.
AUTOAGENT_LLM_MAX_OUTPUT_TOKENS=

# Independent optional Host embedding route. Empty MODEL disables setup.
# BACKEND=openai uses openai.embeddings; litellm uses the vendor embedding route.
AUTOAGENT_EMBEDDING_PROVIDER=openai
AUTOAGENT_EMBEDDING_BACKEND=openai
AUTOAGENT_EMBEDDING_MODEL=
AUTOAGENT_EMBEDDING_API_KEY=
AUTOAGENT_EMBEDDING_BASE_URL=
# Finite positive per-HTTP-call deadline in seconds.
AUTOAGENT_EMBEDDING_TIMEOUT_SECONDS=60
