# 一个 Host 内同时运行的 Operator 上限。
AUTOAGENT_MAX_OPERATOR_CONCURRENCY=32

# 单次 Invocation 的 NodeOccurrence 安全上限。
AUTOAGENT_MAX_NODE_EXECUTIONS_PER_INVOCATION=1000

# sqlite | http | none
AUTOAGENT_RUNTIME_EVENT_SINK=sqlite
AUTOAGENT_SQLITE_PATH=.autoagent/runtime.db

# 仅在 AUTOAGENT_RUNTIME_EVENT_SINK=http 时使用。
# AUTOAGENT_HTTP_SINK_URL=https://example.test/v1/runtime-events
# AUTOAGENT_HTTP_USER_EVENT_SINK_URL=https://example.test/v1/user-events
# AUTOAGENT_HTTP_SINK_TOKEN=
AUTOAGENT_HTTP_SINK_TIMEOUT_SECONDS=10

# 本地只读 Tracing Server。
AUTOAGENT_TRACE_HOST=127.0.0.1
AUTOAGENT_TRACE_PORT=8765
# AUTOAGENT_TRACE_UI_DIRECTORY=/absolute/path/to/custom-tracing-ui
AUTOAGENT_TRACE_REFRESH_SECONDS=0.5
