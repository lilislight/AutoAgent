# Model connections are defined in providers.json in this project directory.
# Optional override: AUTOAGENT_PROVIDERS_FILE=/absolute/path/providers.json
DEEPSEEK_API_KEY=
# Copy to .env here. Process environment overrides this file.
# Required; intentionally empty. Host owns and closes the configured Provider.
# openai: AutoAgent DeepSeekProvider with OpenAI SDK; litellm: native deepseek route.
# llm_request() default; each call can override streaming and output token count.
# Both modes return LLMResponse without configuring a Reducer or User Events.

# Read bundled LiteLLM pricing data instead of fetching it during SDK import.
LITELLM_LOCAL_MODEL_COST_MAP=True
AUTOAGENT_DATABASE_URL=sqlite+aiosqlite:///.autoagent/runtime.db
AUTOAGENT_LOG_LEVEL=info
AUTOAGENT_SERVER_ACCESS_LOG=true
